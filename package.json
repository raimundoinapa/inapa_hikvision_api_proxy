{
  "name": "hikvision-api-server",
  "version": "1.2.0",
  "description": "HikVision API Server with JSPlugin support - Custom HTTP server implementation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:error": "jest tests/error",
    "test:auth": "jest tests/unit/auth.test.js",
    "test:health": "jest tests/unit/health.test.js",
    "test:cameras": "jest tests/integration/cameras.test.js",
    "test:ptz": "jest tests/integration/ptz.test.js",
    "test:streaming": "jest tests/integration/streaming.test.js",
    "test:system": "jest tests/integration/system.test.js",
    "test:version": "jest tests/integration/system.test.js --testNamePattern='api/version'",
    "test:errors": "jest tests/error/error-handling.test.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:server": "node run-tests-with-server.js",
    "test:with-server": "node run-tests-with-server.js"
  },
  "keywords": [
    "cctv",
    "hikcentral",
    "api",
    "proxy",
    "security",
    "hikvision",
    "rate-limiting",
    "jwt",
    "authentication"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "rate-limiter-flexible": "^7.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
