# Server Configuration
# Copia este archivo a .env y reemplaza los valores de ejemplo.
# Genera JWT_SECRET con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
PROTOCOL=http
# Redirige HTTP plano al mismo puerto hacia HTTPS cuando PROTOCOL=https (por defecto true)
#REDIRECT_HTTP_TO_HTTPS=true
# Hosts extra permitidos en el Location del redirect (separados por coma)
#HTTP_REDIRECT_ALLOWED_HOSTS=aps-hikvision-2.inapa.local
# IPs de proxies de confianza (separadas por coma). Solo desde estas IPs se aceptan
# X-Forwarded-For / X-Real-IP para el rate limiter. Vacío = conexiones directas.
#TRUST_PROXY=127.0.0.1
SSL_KEY=
SSL_CERT=
#SERVER_IP=127.0.0.1
SERVER_IP=127.0.0.1
PORT=3000
MAX_POST_SIZE=10485760
# Clave compartida para pantallas/TV (genera una con el comando de JWT_SECRET).
# Las URLs de pantalla deben incluir ?key=<valor>: /screen?key=... y /pantalla1?key=...
# Sin esta variable los endpoints de pantalla responden 401 (fail closed).
SCREEN_ACCESS_KEY=change-me-to-a-long-random-value

# HikVision API
#HIKVISION_API_URL=https://your-hikcentral.example.com
#HIKVISION_PARTNER_KEY=your-partner-key
#HIKVISION_PARTNER_SECRET=your-partner-secret
HIKVISION_API_URL=https://your-hikcentral.example.com
HIKVISION_PARTNER_KEY=your-partner-key
HIKVISION_PARTNER_SECRET=your-partner-secret

# LDAP
# El esquema sigue a PROTOCOL: http -> ldap://...:389, https -> ldaps://...:636
LDAP_URLS=["ldap://dc1.example.com:389","ldap://dc2.example.com:389"]
# Validación del certificado de los DC (por defecto true)
#LDAP_TLS_REJECT_UNAUTHORIZED=true
# Ruta al PEM de la CA interna (o al certificado autofirmado del DC).
# Recomendado: usar nombres DNS en LDAP_URLS para que la validación del certificado coincida.
#LDAP_TLS_CA=C:\ruta\a\internal-root-ca.pem
LDAP_BASEDN=DC=example,DC=local
LDAP_DOMAIN=EXAMPLE
# Grupos de AD con acceso, separados por coma (ej: CCTV,Seguridad). Se compara el CN del DN.
# Los usuarios locales (ADMIN_USERNAME / ADDITIONAL_USERS) no pasan por LDAP ni por este chequeo.
LDAP_ALLOWED_CN=CCTV

# SMART WALL
SMART_WALL_IP=127.0.0.1
SMART_WALL_USER=your-smartwall-user
SMART_WALL_PASS=your-smartwall-password

# Security
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=8h

# Admin User
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Additional Users (JSON array)
# ADDITIONAL_USERS='[{"username":"user1","passwordHash":"$2a$10$..."},{"username":"user2","passwordHash":"$2a$10$..."}]'

# Rate Limiting Configuration (Dual-Layer Protection)
# IP+Username Rate Limiting (targeted attacks)
LOGIN_RATE_LIMIT_POINTS=5
LOGIN_RATE_LIMIT_DURATION=900
LOGIN_RATE_LIMIT_BLOCK_DURATION=900

# IP-Only Rate Limiting (combolist attacks)
IP_LOGIN_RATE_LIMIT_POINTS=50
IP_LOGIN_RATE_LIMIT_DURATION=900
IP_LOGIN_RATE_LIMIT_BLOCK_DURATION=900

# [Referencia, sin uso en el servidor] 3*60*60*1000. Se conserva por si se vuelve a usar.
MIN_TIME_BETWEEN_UPDATES=10800000
# TTL del contenido de cada captura en disco (1 hora)
MIN_TIME_BETWEEN_CAPTURE_UPDATES=3600000
# Barrido de capturas en segundo plano (4 horas). Es un piso: el visor captura y sube
# una imagen al detener cada stream, y la ruta de captura sirve disco mientras no venza el TTL.
CAPTURE_REFRESH_INTERVAL=14400000
# Tope del JPEG que un operador puede subir por /api/camera/capture-upload (bytes, defecto 4 MB)
#CAPTURE_UPLOAD_MAX_BYTES=4194304

# Cámaras PTZ consultadas a la vez al construir el catálogo (2 requests por cámara).
# Antes se lanzaban todas en paralelo; 4 mantiene la carga de HikCentral acotada.
#PTZ_MAX_CONCURRENCY=4

MAX_CLIENTS=5